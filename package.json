{
  "name": "modus",
  "version": "1.19.0",
  "private": true,
  "description": "MODUS — A modular Discord bot with web dashboard",
  "scripts": {
    "postinstall": "corepack pnpm --filter @modus/db run build",
    "licenses:generate": "node scripts/generate-third-party-licenses.js"
  },
  "pnpm": {
    "patchedDependencies": {
      "@discordjs/voice": "bot/patches/@discordjs__voice.patch"
    },
    "overrides": {
      "h3": "^1.15.11",
      "nitropack": ">=2.13.4",
      "devalue": ">=5.8.1",
      "fast-xml-parser": ">=5.7.0",
      "fast-xml-builder": ">=1.2.0",
      "esbuild": ">=0.28.1",
      "tar": ">=7.5.16",
      "brace-expansion": ">=5.0.7",
      "undici@6": "^6.27.0",
      "undici@7": "^7.28.0",
      "shell-quote": ">=1.9.0",
      "svgo": ">=4.0.2",
      "nanoid": "~3.3.17"
    }
  }
}
